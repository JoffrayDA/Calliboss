rules_version = '2';
// À coller dans la console Firebase : Firestore Database → Règles.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Fiche privée du compte : pseudo et codes de ses groupes.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Un groupe se lit par son code (le code fait office d'invitation). Pas de liste, pas de modification.
    match /groups/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;

      // Ce que chaque membre partage. Lisible par les membres du groupe seulement.
      match /members/{uid} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/groups/$(code)/members/$(request.auth.uid));
        allow create, update: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/groups/$(code));
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
